# Copier ce fichier en .env.local (local) et renseigner les mêmes variables dans Vercel.
# Valeurs : Supabase → Project Settings → API Keys / Data API.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Lecture des cahiers par l'IA (côté serveur uniquement, voir docs/guide-lecture-ia.md)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# claude, gemini, ou simulee pour tester sans clé
LECTURE_IA=

# Invitations de membres (US-33), côté serveur uniquement : clé secrète Supabase
# (Project Settings → API Keys → Secret keys). Ne jamais la mettre dans le code.
SUPABASE_SECRET_KEY=
